    ASSURANCE["Independent Assurance<br/>Internal Auditor"]
    SOURCES["1. Enterprise Banking Sources<br/>Customers · Accounts · Payments · Exceptions<br/>Operations · Reference Data · Policies"]

    subgraph DATA["2. Governed Data Foundation — Governance Starts at Bronze"]
        BRONZE["Bronze<br/>Governed Raw Data"]
        SILVER["Silver<br/>Validated · Standardized · Protected"]
        GOLD["Gold<br/>Certified Data · Governed Metrics"]
        BRONZE --> SILVER --> GOLD
    end

    subgraph INTELLIGENCE["3. Trusted Enterprise Intelligence"]
        SEMANTIC["Semantic Intelligence<br/>Governed Definitions & Metrics"]
        KNOWLEDGE["Governed Knowledge<br/>Approved Evidence · Governed Retrieval · Citations"]
    end

    AI["4. Governed AI<br/>Authorized Context · Evaluation · Groundedness"]
